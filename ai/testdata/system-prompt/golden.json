              "name": "read"
            }
          ]
        }
      ],
      "expectedMessage": {
        "role": "system",
        "content": "base",
        "toolsAdded": [
          {
            "name": "bash",
            "description": "bash tool",
            "parameters": {
              "type": "object",
              "properties": {}
            }
          }
        ],
        "timestamp": 10
      },
      "expectedPrompt": "base",
      "expectedTools": [
        {
          "name": "bash",
          "description": "bash tool",
          "parameters": {
            "type": "object",
            "properties": {}
          }
        }
      ]
    },
