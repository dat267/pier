ing&quot;&quot; here&quot;</span>;\n            <span class=\"hljs-keyword\">var</span> interpolated = <span class=\"hljs-string\">$&quot;value=<span class=\"hljs-subst\">{<span class=\"hljs-keyword\">value</span>}</span> count=<span class=\"hljs-subst\">{count}</span>&quot;</span>;\n            <span class=\"hljs-keyword\">var</span> numbers = <span class=\"hljs-number\">0x1f</span> + <span class=\"hljs-number\">0b1010</span> + <span class=\"hljs-number\">1.5e-3</span>;\n            <span class=\"hljs-keyword\">var</span> list = <span class=\"hljs-keyword\">new</span> List&lt;<span class=\"hljs-built_in\">string</span>&gt; { <span class=\"hljs-string\">&quot;a&quot;</span>, <span class=\"hljs-string\">&quot;b&quot;</span> };\n            <span class=\"hljs-keyword\">if</span> (count &gt; <span class=\"hljs-number\">0</span> &amp;&amp; list.Count != <span class=\"hljs-number\">0</span>)\n            {\n                <span class=\"hljs-keyword\">return</span> <span class=\"hljs-string\">$&quot;<span class=\"hljs-subst\">{verbatim}</span> <span class=\"hljs-subst\">{interpolated}</span> <span class=\"hljs-subst\">{numbers}</span>&quot;</span>;\n            }\n            <span class=\"hljs-keyword\">return</span> <span class=\"hljs-string\">&quot;hello, &quot;</span> + <span class=\"hljs-keyword\">value</span>;\n        }\n    }\n\n    <span class=\"hljs-keyword\">interface</span> <span class=\"hljs-title\">IGreet</span> { <span class=\"hljs-function\"><span class=\"hljs-keyword\">void</span> <span class=\"hljs-title\">Greet</span>(<span class=\"hljs-params\"></span>)</span>; }\n}\n",
