  "name": "ruby-43",
  "language": "ruby",
  "code": "#!/usr/bin/env ruby\n# a comment\n=begin\nblock comment\n=end\n\nmodule Demo\n  MAX = 42\n  class Box\n    attr_reader :value\n\n    def initialize(value:, count: 0)\n      @value = value\n      @count = count\n      @@all ||= []\n    end\n\n    def describe(label = \"x\")\n      raw = 'single quoted'\n      interp = \"name=#{@value} count=#{@count}\"\n      heredoc = <<~EOT\n        heredoc #{@value} text\n      EOT\n      regex = /[a-z]+\\/[0-9]{2}/\n      numbers = 0x1f + 0b1010 + 0o17 + 1.5e-3\n      sym = :value\n      puts raw, interp, heredoc, regex, numbers, sym, label\n    end\n  end\nend\n\n>> x = 1\nDemo::Box.new(value: 1).describe\n",
  "html": "<span class=\"hljs-meta\">#!/usr/bin/env ruby</span>\n<span class=\"hljs-comment\"># a comment</span>\n<span class=\"hljs-comment\">=begin\nblock comment\n=end</span>\n\n<span class=\"hljs-class\"><span class=\"hljs-keyword\">module</span> <span class=\"hljs-title\">Demo</span></span>\n  MAX = <span class=\"hljs-number\">42</span>\n  <span class=\"hljs-class\"><span class=\"hljs-keyword\">class</span> <span class=\"hljs-title\">Box</span></span>\n    <span class=\"hljs-keyword\">attr_reader</span> <span class=\"hljs-symbol\">:value</span>\n\n    <span class=\"hljs-function\"><span class=\"hljs-keyword\">def</span> <span class=\"hljs-title\">initialize</span><span class=\"hljs-params\">(<span class=\"hljs-symbol\">value:</span>, <span class=\"hljs-symbol\">count:</span> <span class=\"hljs-number\">0</span>)</span></span>\n      <span class=\"hljs-variable\">@value</span> = value\n      <span class=\"hljs-variable\">@count</span> = count\n      <span class=\"hljs-variable\">@@all</span> <span class=\"hljs-params\">||</span>= []\n    <span class=\"hljs-keyword\">end</span>\n\n    <span class=\"hljs-function\"><span class=\"hljs-keyword\">def</span> <span class=\"hljs-title\">describe</span><span class=\"hljs-params\">(label = <span class=\"hljs-string\">&quot;x&quot;</span>)</span></span>\n      raw = <span class=\"hljs-string\">&#x27;single quoted&#x27;</span>\n      interp = <span class=\"hljs-string\">&quot;name=<span class=\"hljs-subst\">#{<span class=\"hljs-variable\">@value</span>}</span> count=<span class=\"hljs-subst\">#{<span class=\"hljs-variable\">@count</span>}</span>&quot;</span>\n      heredoc = <span class=\"hljs-string\">&lt;&lt;~EOT\n        heredoc <span class=\"hljs-subst\">#{<span class=\"hljs-variable\">@value</span>}</span> text\n      EOT</span>\n      regex = <span class=\"hljs-regexp\">/[a-z]+\\/[0-9]{2}/</span>\n      numbers = <span class=\"hljs-number\">0x1f</span> + <span class=\"hljs-number\">0b1010</span> + <span class=\"hljs-number\">0o17</span> + <span class=\"hljs-number\">1.5e-3</span>\n      sym = <span class=\"hljs-symbol\">:value</span>\n      puts raw, interp, heredoc, regex, numbers, sym, label\n    <span class=\"hljs-keyword\">end</span>\n  <span class=\"hljs-keyword\">end</span>\n<span class=\"hljs-keyword\">end</span>\n\n<span class=\"hljs-meta\">&gt;&gt;</span> x = <span class=\"hljs-number\">1</span>\nDemo::Box.new(<span class=\"hljs-symbol\">value:</span> <span class=\"hljs-number\">1</span>).describe\n",
  "illegal": false,
  "relevance": 44
