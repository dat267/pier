$ORIGIN example.com.
$TTL 3600
@	IN	SOA	ns1.example.com. admin.example.com. (
		2024010101 ; serial
		7200       ; refresh
		3600       ; retry
		1209600    ; expire
		3600 )     ; minimum
	IN	NS	ns1.example.com.
	IN	NS	ns2.example.com.
www	IN	A	192.0.2.1
mail	IN	A	192.0.2.2
ipv6	IN	AAAA	2001:db8::1
txt	IN	TXT	"v=spf1 -all"
